{
  "name": "velella-desktop",
  "version": "0.2.11",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:cli": "cargo build -j 1 --manifest-path ../Cargo.toml -p velella --bin velella-cli --bin velella-runtime --release",
    "prepare:terminal": "node scripts/conpty-runtime.cjs",
    "tauri": "tauri",
    "test": "node --test tests/*.test.mjs",
    "start": "electron .",
    "electron:dev": "npm run build && electron .",
    "package:dir": "npm run build:cli && npm run build && electron-builder --config electron-builder.config.cjs --dir",
    "package": "npm run build:cli && npm run build && electron-builder --config electron-builder.config.cjs",
    "test:electron": "electron electron/smoke.cjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@monaco-editor/react": "^4.7",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-notification": "^2",
    "@xterm/addon-fit": "0.12.0-beta.300",
    "@xterm/addon-search": "0.17.0-beta.300",
    "@xterm/addon-unicode-graphemes": "0.4.0",
    "@xterm/addon-web-links": "0.13.0-beta.300",
    "@xterm/addon-webgl": "0.20.0-beta.299",
    "@xterm/xterm": "6.1.0-beta.303",
    "lucide-react": "^0.468",
    "marked": "18.1.1",
    "monaco-editor": "^0.52",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.5",
    "electron": "44.9.2",
    "electron-builder": "26.15.3",
    "typescript": "^5.8",
    "vite": "^6.3"
  },
  "main": "electron/main.cjs",
  "description": "Velella desktop workbench with native Rust terminals",
  "author": "Velella contributors",
  "desktopName": "velella-desktop"
}
